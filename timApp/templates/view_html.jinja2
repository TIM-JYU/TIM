{% extends "item.jinja2" %}
{% set teacher_mode = route in ("teacher", "answers") %}

{% block title %}{{ item.title }}{% endblock %}

{% block head %}
    {{ super() }}

    {# without this, lazy loading embedded_sagecell won't work because it doesn't know URL root #}
    <link property="sagecell-root" href="https://sagecell.sagemath.org/"/>

    {{ doc_head|safe }}
{% endblock %}

{% set col_1_lg = 2 %}
{% set col_2_lg = 7 %}
{% set col_3_lg = 3 %}

{% set col_1_md = 0 %}
{% set col_2_md = 12 %}
{% set col_3_md = 0 %}

{% set col_1_sm = 0 %}
{% set col_2_sm = 12 %}
{% set col_3_sm = 0 %}

{% block mainctrl %}tim-view{% endblock %}

{% block rightside %}
    {% if access.accessible_to %}
        <tim-time-left end-time="{{ access.accessible_to }}"></tim-time-left>
    {% endif %}

    {% if teacher_mode %}
        <tim-user-list></tim-user-list>
    {% endif %}
{% endblock %}

{# NOTE: Keep the below HTML static (i.e. don't put more variables there, other than the "doc_content"). #}

{% block content %}
    <form name="ignore_me">
        <input type="hidden" id="page_is_dirty" name="page_is_dirty" value="0" />
    </form>
    {{ doc_content|safe }}
    {# The view controller shows the elements with the class empty-document-only only while the document is empty.
       Elements with data-tim-require-right are removed at startup if the user does not have that right to the document. #}
    <div class="empty-document-only" data-tim-require-right="editable" style="display: none">
        <tim-template-list></tim-template-list>
    </div>
    <div class="empty-document-only" data-tim-require-right="manage" style="display: none">
    <bootstrap-panel title="Review document permissions"
                     show-close="true">
        <p>These are the current permissions for this document; please modify if needed.
            You can always modify these permissions from the manage page.</p>
        <tim-rights-editor
                [item-id]="{{ item.id }}">
        </tim-rights-editor>
    </bootstrap-panel>
    </div>
{% endblock %}
