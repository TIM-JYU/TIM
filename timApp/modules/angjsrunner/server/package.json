{
  "name": "angjsrunner",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "start": "node --no-node-snapshot -r ts-node/register -r tsconfig-paths/register ./bin/www.ts",
    "buildtools": "npx rollup -c",
    "buildserver": "npx rollup -c rollup.server.config.js",
    "postinstall": "npm run buildtools",
    "lint": "eslint --report-unused-disable-directives --format codeframe .",
    "lintfix": "eslint --format codeframe . --fix"
  },
  "dependencies": {
    "acorn": "^8.8.0",
    "cookie-parser": "~1.4.7",
    "debug": "^4.3.4",
    "express": "^4.22.3",
    "form-data": "^4.0.6",
    "fp-ts": "^2.12.3",
    "http-errors": "^2.0.0",
    "io-ts": "^2.2.18",
    "isolated-vm": "^7.0.2",
    "morgan": "~1.12.1",
    "node-fetch": "^2.6.9"
  },
  "devDependencies": {
    "@types/acorn": "^6.0.0",
    "@types/cookie-parser": "^1.4.3",
    "@types/debug": "^4.1.7",
    "@types/express": "^4.17.14",
    "@types/http-errors": "^1.8.2",
    "@types/morgan": "^1.9.3",
    "@types/node": "^18.13.0",
    "@types/node-fetch": "^2.6.2",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "eslint": "^9.39.5",
    "eslint-formatter-codeframe": "^7.32.1",
    "rollup": "^2.80.0",
    "rollup-plugin-commonjs": "^10.1.0",
    "rollup-plugin-node-resolve": "^5.2.0",
    "rollup-plugin-typescript": "^1.0.1",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.1.0",
    "tslib": "^2.4.0",
    "typescript": "^4.8.3"
  }
}
